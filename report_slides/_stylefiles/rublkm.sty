%-------------------------------------------------------------------
%  footline layout
%-------------------------------------------------------------------
% put together footline
\setbeamertemplate{footline}{
	\begin{picture}(1,1.3)
		\put( 0,1.6){\textcolor{\footlinecolor}{\rule{\textwidth}{2.0pt}}}								% line
		\put( 1.47,0.9){\textbf{\profname}}
		\put(1.47,0.5){\chairname}											
		\put(21.60,0.1){\includegraphics[width=0.20\hsize]{_figures/RUB_Logo.pdf}}						% rublabel		
		\put( 27,0.6){\textcolor{\structurecolor}{\bfseries\footnotesize\insertframenumber}}	% slide-#
	\end{picture}	
}



%-------------------------------------------------------------------
% titleslide layout
%-------------------------------------------------------------------
\newcommand{\titleslide}[1]{
	{
		\setbeamertemplate{headline}{
			\begin{picture}(27.94,4.35)
				\unitlength1cm
				\unitlength1cm
				\put( 21.80, 0.0){\includegraphics[width=0.165\hsize]{_figures/RUB_label_2000x2000.pdf}}
				\put( 1.53, 2.40){\includegraphics[height=0.02\hsize]{_figures/RUB_schriftzug_3600x236.pdf}}
				\put( 1.53,1.7){\footnotesize\textbf{\chairname}}
				\put(1.53,1){\footnotesize\profname}	
				% Schriftzughoehe eigentlich 1/12 der Logohoehe
			\end{picture}
		}
		\setbeamertemplate{footline}{
		}
		#1 % #1 = begin{frame}...\end{frame}
	}
}



%-------------------------------------------------------------------
% further layout adaptations
%-------------------------------------------------------------------
\unitlength1cm
\raggedright    % switch of first line indentations in all environments
\fboxrule1mm % make linewidth of fcolorbox 1mm
\addtolength{\parskip}{3mm} % vertical distance between paragraphs
\geometry{paperwidth=279.4mm,paperheight=215.9mm} % set size to format of old slides
\setbeamersize{text margin left=14.7mm, text margin right=14.7mm} % -> textwith=250mm

% format of the frametitle and framesubtitle:
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamertemplate{frametitle}[default][left]
\setbeamerfont{framesubtitle}{size=\small, series=\bfseries}
\addtobeamertemplate{frametitle}{\hspace*{0.9cm}}{}							 	% modify title/text x-position
\addtobeamertemplate{frametitle}{\vspace*{1.0cm}}{\vspace*{0.8cm}}	% modify title/text y-position

% color allocations
\setbeamercolor{frametitle}{fg=\titlecolor}       % color for titles, fg:fore-, bg:background
\setbeamercolor{framesubtitle}{fg=\subtitlecolor} % color for framesubtitle
\setbeamercolor{normal text}{fg=\generalcolor}    % change text color globally
\setbeamercolor{structure}{fg=\structurecolor}    % color for structure elements (e.g. items)
\setbeamercolor{alerted text}{fg=\alertcolor}     % color for alerted text
\setbeamercolor{block title}{bg=\boxcolorlight}					% color boxes using blocks
\setbeamercolor{block body}{bg=\boxcolor}			% color boxes using blocks

% math mode font / font size adaptations
\usefonttheme[onlymath]{serif}                                   % serif font for math mode
\setbeamerfont{alerted text}{size=\larger[1],series=\normalfont} % alerted -> larger font size 
\newcommand{\mbeq}{\overset{!}{=}}% must be equal sign

 % structure elements
 \newcommand{\arrow}{\begin{Large}\textcolor{\structurecolor}{\MVRightarrow}\end{Large}$\ $}

% set itemize/enumerate symbols
%\renewcommand*\textbullet{\textcolor{\structurecolor}{\text{$\bullet$}}} % textbullets globally in structure color
\setbeamertemplate{itemize item}{\textbullet} % default itemize item
\newcommand{\arrowitem}{\item[\begin{Large}\textcolor{\structurecolor}{\MVRightarrow}\end{Large}]} % \arrow instead of \item within itemize

% colorboxes
\newenvironment{userbox}[2][\textwidth]
    {\ifthenelse{\equal{#2}{}}
            {\begin{beamercolorbox}[wd=#1,rounded=true,shadow=true,leftskip=2mm,rightskip=2mm]{block body}} %
            {\begin{beamercolorbox}[wd=#1,ht=#2,rounded=true,shadow=true,leftskip=2mm,rightskip=2mm]{block body}}}
  {\end{beamercolorbox}}
   
\newenvironment{userbox2}[2][\textwidth]
 {\ifthenelse{\equal{#2}{}}
            {\begin{beamercolorbox}[wd=#1,rounded=true,shadow=true,leftskip=2mm,rightskip=2mm]{block body}} %
            {\begin{beamercolorbox}[wd=#1,ht=#2,rounded=true,shadow=true,leftskip=2mm,rightskip=2mm]{block body}}}
  {\end{beamercolorbox}}
\AtBeginEnvironment{userbox2}{\setbeamercolor{block body}{bg=\boxcolorlight}}

% theorems/definitions/proofs
%\setbeamertemplate{blocks}[rounded][shadow=true] %[default]
%\AtBeginEnvironment{theorem}{\setbeamercolor{block body}{bg=white}}
%\AtBeginEnvironment{definition}{\setbeamercolor{block body}{bg=white}}
%\AtBeginEnvironment{proof}{\setbeamercolor{block body}{bg=white}}

% references
\newenvironment{reference}{\begin{footnotesize}\color{\refcolor}}{\end{footnotesize}}
\newcommand{\bre}{\begin{reference}}
\newcommand{\ere}{\end{reference}}

% captions of tables and figures
\captionsetup{labelformat=empty}
\setbeamertemplate{caption label separator}{: } % colon without space
\setbeamertemplate{caption}[default] % default/numbered/caption name own line

% supress navigation symbols:
\setbeamertemplate{navigation symbols}{}

% adapt qed symbol 
\setbeamertemplate{qed symbol}{$\blacksquare$}

% visibility of overlay objects
\setbeamercovered{transparent=20} % from 0 to 100

% define command indicate movies
\newcommand{\moviehint}{\LARGE\textcolor{\moviecolor}{\fcolorbox{\moviecolor}{white}{$\, $\Forward}}}

% new command for non-italic formula text
\newcommand{\noni}[1]{\mathrm{#1}}

% boldface mathcal letters
\newcommand{\mcP}{\boldsymbol{\mathcal{P}}}

%-------------------------------------------------------------------
% output of notes
%-------------------------------------------------------------------
\makeatletter
\defbeamertemplate{note page}{plain2}
{
  \vspace{8mm}
  \hbox{\usebeamerfont{frametitle}\insertshortframetitle[width=23cm]}
  \begin{minipage}{2.4\textwidth}
  \normalsize\normalfont\insertnote
  \end{minipage}
}
\makeatother
% options: hide notes/show notes/show only notes/show notes on second screen
% REMARK: if you want to use 'show notes on second screen' you have to include the
%         \usepackage{pgfpages}
\setbeameroption{hide notes} 
\setbeamertemplate{note page}[plain2]





